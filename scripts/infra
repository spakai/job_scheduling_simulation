#!/usr/bin/env bash
set -euo pipefail

command_name=${1:-help}
shift || true
project_name=${JOB_VISIBILITY_COMPOSE_PROJECT:-job-visibility-resilience}
compose=(docker compose --project-name "$project_name")
scheduler_url=${SCHEDULER_DATABASE_URL:-postgresql+psycopg://scheduler_owner:scheduler-local@localhost:5432/scheduler}
edr_url=${EDR_DATABASE_URL:-postgresql+psycopg://edr_owner:edr-local@localhost:5433/edr}
deadline_seconds=${INFRA_READY_TIMEOUT_SECONDS:-300}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "required command is unavailable: $1" >&2
    exit 2
  }
}

compose_cmd() {
  require_command docker
  "${compose[@]}" "$@"
}

ready() {
  require_command curl
  local started now state
  started=$(date +%s)
  while true; do
    state=$(compose_cmd ps --format json 2>/dev/null || true)
    if [[ -n "$state" ]] && ! grep -q '"Health":"starting"\|"State":"restarting"\|"State":"exited"' <<<"$state"; then
      if curl -fsS http://localhost:8081/subjects >/dev/null 2>&1 &&
        curl -fsS http://localhost:8083/connectors >/dev/null 2>&1 &&
        curl -fsS http://localhost:8474/proxies/cassandra >/dev/null 2>&1; then
        echo "infrastructure ready (project=$project_name)"
        return
      fi
    fi
    now=$(date +%s)
    if (( now - started >= deadline_seconds )); then
      echo "infrastructure readiness timed out after ${deadline_seconds}s" >&2
      diagnostics
      return 1
    fi
    sleep 2
  done
}

migrate() {
  SCHEDULER_DATABASE_URL=$scheduler_url .venv/bin/alembic -n scheduler upgrade head
  EDR_DATABASE_URL=$edr_url .venv/bin/alembic -n edr upgrade head
}

diagnostics() {
  compose_cmd ps --all || true
  curl -fsS http://localhost:8083/connectors/edr-jdbc-sink-v1/status || true
  curl -fsS http://localhost:8474/proxies || true
}

case "$command_name" in
  up)
    compose_cmd up -d --build
    ;;
  ready)
    ready
    ;;
  migrate)
    migrate
    ;;
  connector-apply)
    bash infra/kafka/connect/apply.sh
    ;;
  bootstrap)
    compose_cmd up -d --build
    ready
    migrate
    bash infra/kafka/connect/apply.sh
    ;;
  test-postgres)
    RUN_POSTGRES_TESTS=1 SCHEDULER_DATABASE_URL=$scheduler_url EDR_DATABASE_URL=$edr_url \
      .venv/bin/pytest -m postgres "$@"
    ;;
  test-resilience)
    RUN_RESILIENCE_TESTS=1 SCHEDULER_DATABASE_URL=$scheduler_url EDR_DATABASE_URL=$edr_url \
      .venv/bin/pytest -m 'integration or e2e' "$@"
    ;;
  diagnostics)
    diagnostics
    ;;
  down)
    compose_cmd down --remove-orphans
    ;;
  down-volumes)
    if [[ ${CONFIRM_DELETE_TEST_VOLUMES:-} != "$project_name" ]]; then
      echo "refusing volume deletion; set CONFIRM_DELETE_TEST_VOLUMES=$project_name" >&2
      exit 2
    fi
    compose_cmd down --volumes --remove-orphans
    ;;
  help|*)
    echo "usage: scripts/infra {up|ready|migrate|connector-apply|bootstrap|test-postgres|test-resilience|diagnostics|down|down-volumes}"
    ;;
esac
